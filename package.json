    "content:validate": "tsx scripts/validate-content.ts",
    "eval:prompts": "tsx scripts/prompt-eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mock-ai": "tsx test-support/mock-ai-server/cli.ts",
    "check": "npm run format:check && npm run lint && npm run style:check && npm run typecheck && npm run deps:check && npm run content:validate && npm test"
  }
